PORT=3000
APP_BASE_URL=http://localhost:3000
ORDER_NOTIFICATION_EMAIL=ayomideguru2365@gmail.com

# Admin account is created or refreshed from these values at server startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Example: Gmail SMTP with an app password. Keep real credentials in .env only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=Fryday Orders <your-sending-gmail-address@gmail.com>

# Google OAuth web client. Set the authorized redirect URI to APP_BASE_URL/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override when the Google OAuth redirect URI differs from APP_BASE_URL.
GOOGLE_REDIRECT_URI=

# Twilio Verify service for phone-number sign-in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional Twilio Verify locale (defaults to en).
TWILIO_VERIFY_LOCALE=en

# Cloudinary account for admin menu photo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=